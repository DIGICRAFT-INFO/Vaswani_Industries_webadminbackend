# URLs — leave BACKEND_URL empty so images are stored as relative paths (/uploads/...)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_SITE_URL=https://new.vaswaniindustries.com
BACKEND_URL=

# File Upload
STORAGE_MODE=local
MAX_IMAGE_SIZE_MB=10
MAX_PDF_SIZE_MB=50

# Absolute path where uploaded files are stored.
# In standalone mode, Next.js serves static files from .next/standalone/public/
# so uploads must go there — NOT to the project root public/ directory.
UPLOAD_DIR=/home/u374384555/domains/new.vaswaniindustries.com/.next/standalone/public/uploads
