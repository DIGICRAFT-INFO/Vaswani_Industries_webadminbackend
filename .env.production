# VASWANI INDUSTRIES — Production (Hostinger)
# Domain: https://new.vaswaniindustries.com
NODE_ENV=production

# MongoDB Atlas
MONGO_URI=mongodb+srv://vils_admins:VaswaniDatabaseb2026@vaswani-cluster.bddlo5y.mongodb.net/vaswani_db?retryWrites=true&w=majority&appName=Vaswani-Cluster

# JWT
JWT_SECRET=vaswani_super_secret_key_2026_change_this_later
